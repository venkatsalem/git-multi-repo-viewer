{
  "name": "git-multi-repo-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight IntelliJ-style multi-repo Git commit, file, and diff viewer built with Electron, React, and Monaco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/venkatsalem/git-multi-repo-viewer.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "package": "npm run build && node scripts/package.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.511.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
